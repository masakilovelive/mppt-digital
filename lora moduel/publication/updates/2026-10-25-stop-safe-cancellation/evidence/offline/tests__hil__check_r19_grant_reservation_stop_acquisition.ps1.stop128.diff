+}
+Import-SafeDefinitions 'tools/read_r19_grant_reservation_stop_record.ps1'
+Import-SafeDefinitions 'tools/r19_candidate_artifact_common.ps1' @('Get-R19Sha256','Get-R19GrantDiagnosticCandidateContract')
