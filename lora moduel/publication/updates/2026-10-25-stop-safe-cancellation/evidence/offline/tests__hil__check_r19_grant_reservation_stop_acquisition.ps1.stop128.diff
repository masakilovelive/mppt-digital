+Check (Test-Path -LiteralPath (Join-Path $RepoRoot 'tools/read_r19_grant_reservation_stop_record.ps1') -PathType Leaf) 'Separate STOP128 decoder exists'
+$contract=Get-R19GrantReservationStopCandidateContract -RepoRoot $RepoRoot -Enabled $true
+Check ($null-eq(Get-R19GrantReservationStopCandidateContract -RepoRoot $RepoRoot -Enabled $false)) 'STOP128 capability remains absent by default'
+Check ($contract.schema-ceq'vc-lora-r19-grant-reservation-stop-candidate-v1'-and$contract.enabled-is[bool]-and$contract.enabled-and$contract.record_schema-eq1-and$contract.size_bytes-eq128-and$contract.symbol-ceq'vc_lora_r19_grant_reservation_stop_record'-and$contract.decoder_path-ceq'tools/read_r19_grant_reservation_stop_record.ps1'-and$contract.runtime_reader_schema-ceq'vc-lora-r19-runtime-stage-jtag-read-v11') 'STOP128 flat ABI and reader-v11 are exact'
+Check ($contract.decoder_sha256-ceq(Get-FileHash -LiteralPath (Join-Path $RepoRoot $contract.decoder_path) -Algorithm SHA256).Hash) 'STOP128 decoder hash binds actual bytes'
+$null=Assert-R19GrantReservationStopCandidateContract -Value $contract -RepoRoot $RepoRoot -Enabled $true
