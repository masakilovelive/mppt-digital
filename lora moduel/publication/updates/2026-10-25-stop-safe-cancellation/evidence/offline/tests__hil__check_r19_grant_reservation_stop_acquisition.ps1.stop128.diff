+    . ([scriptblock]::Create($node.Extent.Text))
+    Set-Item -Path ('Function:script:'+$node.Name) -Value (Get-Item ('Function:'+$node.Name)).ScriptBlock
+  }
+}
+# Only pure function bodies are imported; the fixture CLI will be explicitly
+# offline and is never allowed to select Execute, Preflight or a native test.
+Import-SafeDefinitions 'tools/r19_grant_reservation_contract.ps1'
