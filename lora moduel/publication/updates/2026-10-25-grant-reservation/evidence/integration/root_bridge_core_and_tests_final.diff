+class R19GrantReservationController final {
+ public:
+  using Role=R19GrantReservationRole;using Op=R19GrantReservationOpcode;
+  using State=R19GrantReservationState;using Reason=R19GrantReservationReason;
+  using Event=R19GrantReservationEvent;using Message=R19GrantReservationWireMessage;
+  bool initialize(Role role,std::uint64_t own_boot,std::uint32_t epoch,std::uint64_t now) noexcept {
+    if(s_.initialized) return fail(Reason::Replay,last_now_);
+    s_.role=role;s_.own_boot_id=own_boot;s_.own_epoch=epoch;s_.initialized=true;last_now_=now;
+    if(!r19_grant_reservation_detail::valid_role(role) || own_boot==0U) return fail(Reason::InvalidConfiguration,now);
+    if(now>std::numeric_limits<std::uint32_t>::max()) return fail(Reason::TimeOverflow,now);
+    return true;
+  }
+  bool initialized() const noexcept {return s_.initialized;}
+  State state() const noexcept {return s_.state;}
+  bool failed() const noexcept {return s_.state==State::Failed;}
+  bool can_prepare() const noexcept {return s_.role==Role::Vehicle && s_.state==State::HelloReady;}
+  bool awaiting_grant() const noexcept {return s_.state==State::AwaitVehicleGrant;}
+  bool holding() const noexcept {return s_.state==State::VehiclePrepared || s_.state==State::VehicleReleaseGranted;}
+  bool should_release() const noexcept {return s_.state==State::VehicleReleaseGranted && peer_bound_ && !failed();}
+  bool ground_request_allowed() const noexcept {return s_.role==Role::Ground && s_.state==State::GroundBound && peer_bound_;}
+  const R19GrantReservationSnapshot& snapshot() const noexcept {return s_;}
+  const Message* peek_reply() const noexcept {return queue_count_==0U?nullptr:&queue_[queue_head_];}
+  bool pop_reply() noexcept {
+    if(queue_count_==0U) return false;
+    queue_head_=(queue_head_+1U)%queue_.size();--queue_count_;return true;
+  }
+  bool note_reply_completed(Op opcode,std::uint64_t now) noexcept {
+    if(failed()) return true;
+    if(!tick(now)) return false;
+    if(!r19_grant_reservation_detail::response_opcode(opcode)) return fail(Reason::InvalidWire,now);
+    journal(Event::ReplyCommitted,now,static_cast<std::uint32_t>(opcode));return true;
+  }
+  bool abort(Reason reason,std::uint64_t now,std::uint32_t detail=0U) noexcept {
+    return fail(reason==Reason::None?Reason::ExternalFault:reason,now,detail);
+  }
+  bool observe_local_epoch(std::uint32_t epoch,std::uint64_t now) noexcept {
+    if(!tick(now)) return false;
+    return epoch==s_.own_epoch || fail(Reason::WrongEpoch,now,epoch);
+  }
+  bool on_ground_baseline(std::uint16_t session,std::uint16_t cycle,std::uint64_t now) noexcept {
+    if(!tick(now)) return false;
+    if(s_.role!=Role::Ground || (s_.state!=State::Cold && s_.state!=State::HelloPending && s_.state!=State::HelloReady)) return fail(Reason::WrongState,now);
+    if(session==0U) return fail(Reason::WrongGrant,now);
+    if(baseline_session_!=0U && session==baseline_session_ && cycle==baseline_cycle_) return true;
+    if(baseline_session_!=0U && !r19_grant_reservation_detail::fresh(session,cycle,baseline_session_,baseline_cycle_)) return fail(Reason::WrongGrant,now);
+    baseline_session_=session;baseline_cycle_=cycle;s_.grant_session=session;s_.grant_cycle=cycle;
+    const bool pending_hello=s_.state==State::HelloPending;
+    if(pending_hello) s_.state=State::HelloReady;
+    journal(Event::Baseline,now);
+    if(pending_hello) return reply(Op::HelloReply,now);
+    return true;
+  }
+  bool handle_command(const Message& m,std::uint64_t now) noexcept {
+    using namespace r19_grant_reservation_detail;
+    // An event must not revive an expired phase merely because the bridge has
+    // not run its periodic tick yet. The original phase clocks remain intact.
+    if(!tick(now)) return false;
+    if(!semantic(m,false)) return fail(Reason::InvalidWire,now);
+    if(m.role!=s_.role) return fail(Reason::WrongRole,now);
+    if(m.opcode==Op::HelloRequest) {
+      if(s_.state!=State::Cold || s_.reader_session!=0U) return fail(Reason::Replay,now);
+      s_.reader_session=m.reader_session;s_.slot_nonce=m.slot_nonce;
+      s_.state=(s_.role==Role::Vehicle || baseline_session_!=0U)?State::HelloReady:State::HelloPending;
+      journal(Event::Hello,now);
+      if(s_.state==State::HelloReady) return reply(Op::HelloReply,now);
+      return true;
+    }
+    if(m.reader_session!=s_.reader_session || m.slot_nonce!=s_.slot_nonce || s_.reader_session==0U) return fail(Reason::WrongScope,now);
+    const bool peer=m.opcode==Op::BindPeerGround || m.opcode==Op::BindPeerVehicle || m.opcode==Op::TailPermitGround;
+    if(!peer && m.boot_id!=s_.own_boot_id) return fail(Reason::WrongBoot,now);
+    if(!peer && m.usb_epoch!=s_.own_epoch) return fail(Reason::WrongEpoch,now);
+    switch(m.opcode) {
+      case Op::PrepareVehicle:
+        if(!can_prepare()) return fail(Reason::WrongState,now);
+        baseline_session_=m.grant_session;baseline_cycle_=m.grant_cycle;prepare_start_=now;prepare_active_=true;
+        s_.state=State::AwaitVehicleGrant;journal(Event::Prepare,now);return true;
+      case Op::BindGround:
+        if(s_.state!=State::HelloReady || !fresh(m.grant_session,m.grant_cycle,baseline_session_,baseline_cycle_)) return fail(Reason::WrongGrant,now);
+        set_tuple(m);prepare_start_=now;prepare_active_=true;s_.state=State::GroundLocalBound;
+        journal(Event::BoundLocal,now);return true;
+      case Op::BindPeerGround:
+        if(s_.state!=State::GroundLocalBound || peer_bound_) return fail(Reason::WrongState,now);
+        if(!tuple(m,now)) return false;
+        s_.peer_boot_id=m.boot_id;s_.peer_epoch=m.usb_epoch;peer_bound_=true;s_.state=State::GroundBound;
+        journal(Event::BoundPeer,now);return reply(Op::Bound,now);
+      case Op::BindPeerVehicle:
+        if(s_.state!=State::VehiclePrepared || peer_bound_) return fail(Reason::WrongState,now);
+        if(!tuple(m,now)) return false;
+        s_.peer_boot_id=m.boot_id;s_.peer_epoch=m.usb_epoch;peer_bound_=true;journal(Event::BoundPeer,now);return true;
+      case Op::ReleaseGrant:
+        if(s_.state!=State::VehiclePrepared || !peer_bound_) return fail(Reason::WrongState,now);
+        if(!tuple(m,now) || !hold_valid(now)) return false;
+        s_.state=State::VehicleReleaseGranted;journal(Event::ReleaseGrant,now,static_cast<std::uint32_t>(m.device_ms));return true;
+      case Op::TailPermitGround:
+        if(s_.role!=Role::Ground || !ground_held_ || tail_permit_seen_ || !peer_bound_ ||
+           (s_.state!=State::GroundHeld && s_.state!=State::GroundGranted)) return fail(Reason::WrongState,now);
+        if(m.boot_id!=s_.peer_boot_id) return fail(Reason::WrongBoot,now);
+        if(m.usb_epoch!=s_.peer_epoch) return fail(Reason::WrongEpoch,now);
+        if(!tuple(m,now)) return false;
+        tail_permit_seen_=true;s_.tail_permit_received_ms=now;peer_tail_claim_=m.device_ms;
+        if(ground_grant_seen_) s_.state=State::GroundTailPermitted;
+        journal(Event::TailPermit,now,static_cast<std::uint32_t>(m.device_ms));return true;
+      default: return fail(Reason::InvalidWire,now);
+    }
+  }
+  bool on_prepared(std::uint16_t session,std::uint16_t cycle,std::uint32_t token,
+      std::uint32_t generation,std::uint64_t deadline,std::uint64_t now) noexcept {
+    if(!tick(now)) return false;
+    if(!awaiting_grant()) return fail(Reason::WrongState,now);
+    if(!r19_grant_reservation_detail::fresh(session,cycle,baseline_session_,baseline_cycle_) || token==0U || generation==0U) return fail(Reason::WrongGrant,now);
+    if(deadline<=now || deadline-now>750U) return fail(Reason::UnsafeHold,now);
+    s_.grant_session=session;s_.grant_cycle=cycle;s_.action_token=token;s_.writer_generation=generation;
+    hold_deadline_=deadline;s_.state=State::VehiclePrepared;journal(Event::Prepared,now);return reply(Op::Prepared,now);
+  }
+  // Bridge must first validate the exact canonical #21 and actual adapter Held
+  // event. This callback never manufactures an adapter request or moves t0.
+  bool on_ground_held(std::uint64_t t0,std::uint16_t baseline_session,
+      std::uint16_t baseline_cycle,std::uint64_t now) noexcept {
+    if(!tick(now)) return false;
+    if(!ground_request_allowed() || ground_held_) return fail(Reason::WrongState,now);
+    if(baseline_session!=baseline_session_ || baseline_cycle!=baseline_cycle_ ||
+       !r19_grant_reservation_detail::fresh(s_.grant_session,s_.grant_cycle,baseline_session,baseline_cycle)) return fail(Reason::WrongGrant,now);
+    if(t0>now || t0<last_journal_ms_) return fail(Reason::ClockRegression,now);
+    if(now-t0>500U) return fail(Reason::GrantWaitExpired,now);
+    s_.ground_t0_ms=t0;ground_held_=true;prepare_active_=false;s_.state=State::GroundHeld;
+    journal(Event::GroundHeld,t0);return reply(Op::GroundHeld,t0);
+  }
+  bool on_ground_grant(std::uint16_t session,std::uint16_t cycle,std::uint64_t now) noexcept {
+    if(!tick(now)) return false;
+    if(!ground_held_ || ground_grant_seen_ || s_.role!=Role::Ground) return fail(Reason::WrongState,now);
+    if(session!=s_.grant_session || cycle!=s_.grant_cycle) return fail(Reason::WrongGrant,now);
+    if(now<s_.ground_t0_ms || now-s_.ground_t0_ms>500U) return fail(Reason::GrantWaitExpired,now);
+    ground_grant_seen_=true;s_.ground_grant_ms=now;s_.state=tail_permit_seen_?State::GroundTailPermitted:State::GroundGranted;
+    journal(Event::GrantObserved,now);return true;
+  }
+  bool on_grant_write_accepted(std::uint16_t session,std::uint16_t cycle,std::uint32_t token,
+      std::uint32_t generation,std::uint64_t now) noexcept {
+    if(!tick(now)) return false;
+    if(!should_release() || !hold_valid(now)) return fail_if_healthy(Reason::WrongState,now);
+    if(!tuple(session,cycle,token,generation,now)) return false;
+    s_.grant_write_ms=now;grant_written_=true;prepare_active_=false;s_.state=State::VehicleGrantWritten;
+    journal(Event::GrantWritten,now);return true;
+  }
+  bool on_tail(std::uint16_t session,std::uint16_t cycle,std::uint32_t token,
+      std::uint32_t generation,std::uint64_t now) noexcept {
+    if(!tick(now)) return false;
+    if(s_.role!=Role::Vehicle || s_.state!=State::VehicleGrantWritten || !grant_written_) return fail(Reason::WrongState,now);
+    if(!tuple(session,cycle,token,generation,now)) return false;
+    if(now<s_.grant_write_ms || now-s_.grant_write_ms<550U) return fail(Reason::UnsafeHold,now);
+    s_.tail_ms=now;tail_seen_=true;s_.state=State::VehicleTailReady;journal(Event::TailObserved,now);return reply(Op::TailReady,now);
+  }
+  // Caller has validated complete canonical VCBN and correlated Grant identity;
+  // no raw arrival, prefix, UART acceptance, or PC timestamp may call this.
+  bool on_vehicle_vcbn(std::uint16_t session,std::uint16_t cycle,std::uint64_t now) noexcept {
+    if(!tick(now)) return false;
+    if(s_.role!=Role::Vehicle || s_.state!=State::VehicleTailReady || !tail_seen_) return fail(Reason::WrongState,now);
+    if(session!=s_.grant_session || cycle!=s_.grant_cycle) return fail(Reason::WrongGrant,now);
+    if(now<s_.tail_ms || now-s_.tail_ms>500U) return fail(Reason::VehicleWindowExpired,now);
+    s_.state=State::Started;journal(Event::Started,now);return true;
+  }
+  bool negotiation_allowed(std::uint64_t now) const noexcept {
+    if(!initialized() || failed() || s_.role!=Role::Ground || !ground_grant_seen_ || !tail_permit_seen_ || now<last_now_ ||
+       now>std::numeric_limits<std::uint32_t>::max()) return false;
+    if(s_.state==State::Started) return true;
+    return now>=s_.ground_grant_ms && now-s_.ground_grant_ms>=100U &&
+           now>=s_.tail_permit_received_ms && now-s_.tail_permit_received_ms>=100U &&
+           now>=s_.ground_t0_ms && now-s_.ground_t0_ms<=28000U &&
+           now-s_.ground_grant_ms<=2000U;
+  }
+  bool on_ground_negotiation_started(std::uint64_t now) noexcept {
+    if(!tick(now)) return false;
+    if(s_.state==State::Started || !negotiation_allowed(now)) return fail(Reason::WrongState,now);
+    s_.state=State::Started;journal(Event::Started,now);return true;
+  }
+  bool tick(std::uint64_t now) noexcept {
+    if(!time(now)) return false;
+    if(holding() && !hold_valid(now)) return false;
+    if(prepare_active_ && now-prepare_start_>=8000U) return fail(Reason::PrepareExpired,now);
+    if(ground_held_ && s_.state!=State::Started) {
+      if(now-s_.ground_t0_ms>28000U) return fail(Reason::GrantWaitExpired,now);
+      if(!ground_grant_seen_ && now-s_.ground_t0_ms>500U) return fail(Reason::GrantWaitExpired,now);
+      if(ground_grant_seen_ && now-s_.ground_grant_ms>2000U) return fail(Reason::TailWaitExpired,now);
+    }
+    if(tail_seen_ && s_.state!=State::Started && now-s_.tail_ms>500U) return fail(Reason::VehicleWindowExpired,now);
+    return true;
+  }
+ private:
+  R19GrantReservationSnapshot s_{};
+  std::array<Message,8U> queue_{};std::size_t queue_head_{0U},queue_count_{0U};
+  std::uint16_t baseline_session_{0U},baseline_cycle_{0U};
+  std::uint64_t last_now_{0U},last_journal_ms_{0U},prepare_start_{0U},hold_deadline_{0U},peer_tail_claim_{0U};
+  bool prepare_active_{false},peer_bound_{false},ground_held_{false},ground_grant_seen_{false};
+  bool grant_written_{false},tail_seen_{false},tail_permit_seen_{false};
+  bool time(std::uint64_t now) noexcept {
+    if(failed()) return false;
+    if(!s_.initialized) return fail(Reason::InvalidConfiguration,now);
+    if(now<last_now_) return fail(Reason::ClockRegression,last_now_,static_cast<std::uint32_t>(now));
+    last_now_=now;
+    if(now>std::numeric_limits<std::uint32_t>::max()) return fail(Reason::TimeOverflow,now);
+    return true;
+  }
+  bool hold_valid(std::uint64_t now) noexcept {return now<hold_deadline_ || fail(Reason::HoldExpired,now);}
+  void set_tuple(const Message& m) noexcept {s_.grant_session=m.grant_session;s_.grant_cycle=m.grant_cycle;s_.action_token=m.action_token;s_.writer_generation=m.writer_generation;}
+  bool tuple(const Message& m,std::uint64_t now) noexcept {return tuple(m.grant_session,m.grant_cycle,m.action_token,m.writer_generation,now);}
+  bool tuple(std::uint16_t session,std::uint16_t cycle,std::uint32_t token,std::uint32_t generation,std::uint64_t now) noexcept {
+    if(session!=s_.grant_session || cycle!=s_.grant_cycle) return fail(Reason::WrongGrant,now);
+    return (token==s_.action_token && generation==s_.writer_generation) || fail(Reason::WrongToken,now);
+  }
+  bool reply(Op opcode,std::uint64_t now) noexcept {
+    if(queue_count_>=queue_.size()) return fail(Reason::QueueFull,now);
+    Message m{};m.opcode=opcode;m.role=s_.role;m.reader_session=s_.reader_session;m.slot_nonce=s_.slot_nonce;
+    m.boot_id=s_.own_boot_id;m.usb_epoch=s_.own_epoch;m.grant_session=s_.grant_session;m.grant_cycle=s_.grant_cycle;
+    if(opcode!=Op::HelloReply) {m.action_token=s_.action_token;m.writer_generation=s_.writer_generation;}
+    m.device_ms=now;
+    if(!r19_grant_reservation_detail::semantic(m,true)) return fail(Reason::InvalidWire,now);
+    queue_[(queue_head_+queue_count_)%queue_.size()]=m;++queue_count_;return true;
+  }
+  bool fail_if_healthy(Reason reason,std::uint64_t now) noexcept {return failed()?false:fail(reason,now);}
+  bool fail(Reason reason,std::uint64_t now,std::uint32_t detail=0U) noexcept {
+    if(failed()) return false;
+    s_.reason=reason;s_.state=State::Failed;
+    journal(Event::Failure,now,detail);s_.frozen=true;
+    // Generic Fault does not overwrite token/generation with an error code.
+    // If scope/time is unavailable, JTAG first-failure evidence remains final.
+    if(queue_count_<queue_.size() && s_.reader_session!=0U && (s_.slot_nonce>>48U)==0x521BU &&
+       s_.own_boot_id!=0U && now<=std::numeric_limits<std::uint32_t>::max()) {
+      Message m{};m.opcode=Op::Fault;m.role=s_.role;m.reader_session=s_.reader_session;m.slot_nonce=s_.slot_nonce;
+      m.boot_id=s_.own_boot_id;m.usb_epoch=s_.own_epoch;m.grant_session=s_.grant_session;m.grant_cycle=s_.grant_cycle;
+      m.action_token=s_.action_token;m.writer_generation=s_.writer_generation;m.device_ms=now;
+      queue_[(queue_head_+queue_count_)%queue_.size()]=m;++queue_count_;
+    }
+    return false;
+  }
+  void journal(Event event,std::uint64_t now,std::uint32_t aux=0U) noexcept {
+    if(s_.frozen) return;
+    R19GrantReservationJournalEntry entry{};entry.event=static_cast<std::uint32_t>(event);
+    entry.state_reason=static_cast<std::uint32_t>(s_.state)|(static_cast<std::uint32_t>(s_.reason)<<16U);
+    entry.timestamp_ms=now;entry.grant_tuple=static_cast<std::uint32_t>(s_.grant_session)|(static_cast<std::uint32_t>(s_.grant_cycle)<<16U);
+    entry.action_token=s_.action_token;entry.writer_generation=s_.writer_generation;entry.aux=aux;
+    if(s_.event_count!=std::numeric_limits<std::uint32_t>::max()) ++s_.event_count;
+    if(s_.journal_count<12U) {s_.journal[s_.journal_count]=entry;++s_.journal_count;}
+    else {for(std::size_t i=8U;i<11U;++i)s_.journal[i]=s_.journal[i+1U];s_.journal[11U]=entry;
+      if(s_.journal_dropped!=std::numeric_limits<std::uint16_t>::max())++s_.journal_dropped;}
+    last_journal_ms_=now;
+  }
+};
+static_assert(sizeof(R19GrantReservationJournalEntry)==32U);
+static_assert(BulkSessionTiming::grant_wait_budget_ms==500U);
+static_assert(BulkSessionTiming::direction_guard_ms==100U);
+static_assert(BulkSessionTiming::hard_lease_ms==28000U);
+static_assert(BulkSessionAccounting::completion_deadline_ms==30000U);
+} // namespace vc_lora::experimental
diff --git a/firmware/high_speed/r19_grant_reservation_record.hpp b/firmware/high_speed/r19_grant_reservation_record.hpp
new file mode 100644
index 0000000..ef1dc9d
--- /dev/null
+++ b/firmware/high_speed/r19_grant_reservation_record.hpp
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include "r19_grant_reservation.hpp"
+
+namespace vc_lora::experimental {
+
+// Separate diagnostic ABI. No reserved word of any existing record is reused.
+// Words0..31 header; words32..127 twelve chronological journal entries of eight
+// words (first8/last4). Entire record freezes at first controller failure.
+class alignas(4) R19GrantReservationRecord final {
+ public:
+  volatile std::uint32_t words[128U]{};
+
+  bool initialize(R19GrantReservationRole role,
+      const std::array<std::uint32_t,4U>& build,
+      const std::array<std::uint32_t,4U>& boot) noexcept {
+    if(words[2U]==0x52313952U || !r19_grant_reservation_detail::valid_role(role) ||
+       (build[0U]|build[1U]|build[2U]|build[3U])==0U ||
+       (boot[0U]|boot[1U])==0U) return false;
+    words[0U]=1U;words[1U]=1U;
+    for(std::size_t i=2U;i<128U;++i) words[i]=0U;
+    words[2U]=0x52313952U;words[3U]=1U;words[4U]=static_cast<std::uint32_t>(role);
+    for(std::size_t i=0U;i<4U;++i){words[5U+i]=build[i];words[9U+i]=boot[i];}
+    words[13U]=1U;words[14U]=512U;words[18U]=boot[0U];words[19U]=boot[1U];
+    words[1U]=2U;words[0U]=0U;return true;
+  }
+
+  bool observe(const R19GrantReservationSnapshot& s) noexcept {
+    if(words[2U]!=0x52313952U || words[0U]!=0U || (words[1U]&1U)!=0U ||
+       !s.initialized || words[4U]!=static_cast<std::uint32_t>(s.role) ||
+       s.own_boot_id!=(static_cast<std::uint64_t>(words[9U])|
+                      (static_cast<std::uint64_t>(words[10U])<<32U)) ||
+       static_cast<std::uint32_t>(s.state)>14U || static_cast<std::uint32_t>(s.reason)>21U ||
+       s.journal_count>12U || s.event_count!=static_cast<std::uint32_t>(s.journal_count)+s.journal_dropped ||
+       (s.journal_dropped!=0U && s.journal_count!=12U) ||
+       (s.frozen!=(s.state==R19GrantReservationState::Failed)) ||
+       (s.frozen!=(s.reason!=R19GrantReservationReason::None))) return false;
+    for(std::size_t i=0U;i<s.journal_count;++i) {
+      const auto& entry=s.journal[i];
+      const auto state=entry.state_reason&0xFFFFU;
+      const auto reason=entry.state_reason>>16U;
+      const bool failure=entry.event==15U;
+      if(entry.event==0U || entry.event>15U || state>14U || reason>21U ||
+         (i!=0U && entry.timestamp_ms<s.journal[i-1U].timestamp_ms) ||
+         failure!=(state==14U) || failure!=(reason!=0U) ||
+         (failure && (!s.frozen || i+1U!=s.journal_count))) return false;
+    }
+    if(s.journal_count!=0U && s.journal[s.journal_count-1U].state_reason!=
+       (static_cast<std::uint32_t>(s.state)|(static_cast<std::uint32_t>(s.reason)<<16U))) return false;
+    if(words[13U]==7U) return true;
+    const auto state_reason=static_cast<std::uint32_t>(s.state)|
+        (static_cast<std::uint32_t>(s.reason)<<16U);
+    if(words[16U]==s.event_count && words[15U]==state_reason &&
+       words[22U]==s.own_epoch && words[23U]==s.peer_epoch &&
+       words[26U]==static_cast<std::uint32_t>(s.reader_session) &&
+       words[27U]==static_cast<std::uint32_t>(s.reader_session>>32U)) return true;
+    if(words[1U]>std::numeric_limits<std::uint32_t>::max()-2U) return false;
+    if(s.frozen && (s.journal_count==0U || s.journal[s.journal_count-1U].event!=15U)) return false;
+    const auto next_sequence=words[1U]+2U;
+    words[0U]=1U;words[1U]=next_sequence-1U;
+    words[13U]=s.frozen?7U:1U;words[15U]=state_reason;words[16U]=s.event_count;
+    words[17U]=static_cast<std::uint32_t>(s.journal_count)|(static_cast<std::uint32_t>(s.journal_dropped)<<16U);
+    words[18U]=static_cast<std::uint32_t>(s.own_boot_id);words[19U]=static_cast<std::uint32_t>(s.own_boot_id>>32U);
+    words[20U]=static_cast<std::uint32_t>(s.peer_boot_id);words[21U]=static_cast<std::uint32_t>(s.peer_boot_id>>32U);
+    words[22U]=s.own_epoch;words[23U]=s.peer_epoch;
+    words[24U]=static_cast<std::uint32_t>(s.slot_nonce);words[25U]=static_cast<std::uint32_t>(s.slot_nonce>>32U);
+    words[26U]=static_cast<std::uint32_t>(s.reader_session);words[27U]=static_cast<std::uint32_t>(s.reader_session>>32U);
+    words[28U]=static_cast<std::uint32_t>(s.grant_session)|(static_cast<std::uint32_t>(s.grant_cycle)<<16U);
+    words[29U]=s.action_token;words[30U]=s.writer_generation;words[31U]=0U;
+    for(std::size_t i=0U;i<12U;++i) {
+      const auto offset=32U+8U*i;
+      const auto entry=i<s.journal_count?s.journal[i]:R19GrantReservationJournalEntry{};
+      words[offset]=entry.event;words[offset+1U]=entry.state_reason;
+      words[offset+2U]=static_cast<std::uint32_t>(entry.timestamp_ms);
+      words[offset+3U]=static_cast<std::uint32_t>(entry.timestamp_ms>>32U);
+      words[offset+4U]=entry.grant_tuple;words[offset+5U]=entry.action_token;
+      words[offset+6U]=entry.writer_generation;words[offset+7U]=entry.aux;
+    }
+    words[1U]=next_sequence;words[0U]=0U;return true;
+  }
+};
+static_assert(sizeof(R19GrantReservationRecord)==512U);
+static_assert(alignof(R19GrantReservationRecord)>=4U);
+} // namespace vc_lora::experimental
diff --git a/tests/host/standalone/r19_grant_reservation_tests.cpp b/tests/host/standalone/r19_grant_reservation_tests.cpp
new file mode 100644
index 0000000..236db05
--- /dev/null
+++ b/tests/host/standalone/r19_grant_reservation_tests.cpp
@@ -0,0 +1,329 @@
+#if defined(VC_LORA_R19_GRANT_RESERVATION_LEGACY_RED)
+#include "vc_lora/tdd_vehicle.hpp"
+#include <iostream>
+int main() {
+  vc_lora::TddConfig config{};
+  vc_lora::LinkDiagnostics diagnostics{};
+  vc_lora::VehicleTddController vehicle(config, diagnostics);
+  vehicle.reset(640U, 2U, 0U);
+  vc_lora::TddInput input{};
+  input.now_ms = 3000U;
+  (void)vehicle.tick(input);
+  input.now_ms = 3016U;
+  (void)vehicle.tick(input);
+  input.now_ms = 3017U;
+  const auto action = vehicle.tick(input);
+  const bool no_unreleased_grant = action.type != vc_lora::LinkActionType::SendGrant;
+  std::cout << "legacy-no-reservation-hold-characterization checks=1 failures="
+            << (no_unreleased_grant ? 0 : 1)
+            << " grant_issued_before_diagnostic_release=" << !no_unreleased_grant << '\n';
+  return no_unreleased_grant ? 0 : 1;
+}
+#else
+#include "../../../firmware/high_speed/r19_grant_reservation.hpp"
+#include "../../../firmware/high_speed/r19_grant_reservation_record.hpp"
+#include <array>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+
+namespace {
+using namespace vc_lora;
+using namespace vc_lora::experimental;
+using Role = R19GrantReservationRole;
+using Op = R19GrantReservationOpcode;
+using State = R19GrantReservationState;
+using Reason = R19GrantReservationReason;
+using Message = R19GrantReservationWireMessage;
+unsigned checks = 0U;
+unsigned failures = 0U;
+void check(bool value, const char* label) {
+  ++checks;
+  if (!value) { ++failures; if (failures <= 25U) std::cerr << "FAIL " << label << '\n'; }
+}
+Message command(Op opcode, Role role, std::uint64_t boot, std::uint32_t epoch) {
+  Message m{};
+  m.opcode = opcode; m.role = role; m.reader_session = 123U;
+  m.slot_nonce = 0x521B000000000123ULL; m.boot_id = boot; m.usb_epoch = epoch;
+  return m;
+}
+Message tuple_command(Op opcode, Role role, std::uint64_t boot,
+                      std::uint32_t epoch) {
+  auto m = command(opcode, role, boot, epoch);
+  m.grant_session = 640U; m.grant_cycle = 2U;
+  m.action_token = 7U; m.writer_generation = 9U;
+  return m;
+}
+void pop(R19GrantReservationController& c, Op expected) {
+  check(c.peek_reply() != nullptr && c.peek_reply()->opcode == expected,
+        "expected fixed reply is queued");
+  check(c.pop_reply(), "whole-frame committed reply may be popped");
+}
+struct Pair {
+  R19GrantReservationController ground{};
+  R19GrantReservationController vehicle{};
+  Pair() {
+    check(ground.initialize(Role::Ground, 11U, 0U, 100U), "Ground initialize epoch zero");
+    check(vehicle.initialize(Role::Vehicle, 22U, 1U, 100U), "Vehicle initialize");
+    auto g = command(Op::HelloRequest, Role::Ground, 0U, 0U);
+    auto v = command(Op::HelloRequest, Role::Vehicle, 0U, 0U);
+    check(ground.handle_command(g, 101U) && ground.peek_reply() == nullptr,
+          "Ground Hello remains pending before actual RF baseline");
+    check(ground.on_ground_baseline(640U, 1U, 102U), "real baseline callback");
+    pop(ground, Op::HelloReply);
+    check(vehicle.handle_command(v, 103U), "Vehicle Hello accepted once");
+    pop(vehicle, Op::HelloReply);
+    auto prepare = command(Op::PrepareVehicle, Role::Vehicle, 22U, 1U);
+    prepare.grant_session = 640U; prepare.grant_cycle = 1U;
+    check(vehicle.handle_command(prepare, 104U) && vehicle.awaiting_grant(),
+          "Prepare waits for bridge-observed real issued Grant");
+    check(vehicle.on_prepared(640U, 2U, 7U, 9U, 850U, 110U),
+          "actual pending action identity and bounded exclusive hold");
+    pop(vehicle, Op::Prepared);
+    check(!vehicle.should_release() && vehicle.holding(),
+          "zero RF writes permitted before explicit release");
+    check(ground.handle_command(tuple_command(Op::BindGround, Role::Ground, 11U, 0U), 111U),
+          "bind own Ground tuple");
+    check(!ground.ground_request_allowed(), "peer binding also mandatory");
+    check(ground.handle_command(tuple_command(Op::BindPeerGround, Role::Ground, 22U, 1U), 112U),
+          "bind peer Vehicle identity");
+    pop(ground, Op::Bound);
+    check(vehicle.handle_command(tuple_command(Op::BindPeerVehicle, Role::Vehicle, 11U, 0U), 113U),
+          "bind peer Ground on prepared Vehicle");
+    check(ground.ground_request_allowed(), "bound Ground permits exact request callback");
+  }
+  void held(std::uint64_t t0 = 200U) {
+    check(ground.on_ground_held(t0, 640U, 1U, t0), "actual original held callback");
+    pop(ground, Op::GroundHeld);
+  }
+  void released() {
+    auto release = tuple_command(Op::ReleaseGrant, Role::Vehicle, 22U, 1U);
+    release.device_ms = 200U;  // Peer claim, never a Vehicle local timestamp.
+    check(vehicle.handle_command(release, 220U) && vehicle.should_release(),
+          "matching explicit release authorizes same held action once");
+    check(vehicle.on_grant_write_accepted(640U, 2U, 7U, 9U, 230U),
+          "actual UART acceptance retires pending release");
+    check(!vehicle.should_release() && !vehicle.holding(), "no duplicate physical write");
+  }
+};
+
+void codec() {
+  auto hello = command(Op::HelloRequest, Role::Ground, 0U, 0U);
+  MavlinkFrame wire{};
+  check(r19_encode_grant_reservation_frame(hello, false, 1U, wire) && wire.size == 66U,
+        "reservation exact66 unsigned MAVLink2 frame");
+  check(r19_is_grant_reservation_namespace(wire), "exclusive private namespace");
+  Message decoded{};
+  check(r19_decode_grant_reservation_frame(wire.bytes.data(), wire.size, false, decoded) &&
+            decoded.slot_nonce == hello.slot_nonce && decoded.reader_session == 123U,
+        "canonical wire roundtrip");
+  for (std::size_t index = 0U; index < wire.size; ++index) {
+    auto damaged = wire; damaged.bytes[index] ^= 1U;
+    Message output{}; output.boot_id = 999U;
+    check(!r19_decode_grant_reservation_frame(damaged.bytes.data(), damaged.size, false, output) &&
+              output.boot_id == 999U, "every single-bit mutation rejected without output mutation");
+  }
+  check(!r19_decode_grant_reservation_frame(wire.bytes.data(), wire.size - 1U, false, decoded),
+        "partial wire rejected");
+  check(!r19_decode_grant_reservation_frame(wire.bytes.data(), wire.size, true, decoded),
+        "request component not response component");
+  auto changed = hello; changed.flags = 1U;
+  check(!r19_encode_grant_reservation_frame(changed, false, 1U, wire), "nonzero flags forbidden");
+  changed = hello; changed.slot_nonce = 123U;
+  check(!r19_encode_grant_reservation_frame(changed, false, 1U, wire), "nonce namespace tag required");
+  changed = hello; changed.slot_nonce = 0x521B000000000000ULL;
+  check(!r19_encode_grant_reservation_frame(changed, false, 1U, wire), "tagged nonce requires nonzero private identity");
+  changed = hello; changed.opcode = Op::Started;
+  check(!r19_encode_grant_reservation_frame(changed, true, 1U, wire), "Started not a wire opcode");
+  changed = tuple_command(Op::TailReady, Role::Vehicle, 22U, 1U);
+  changed.device_ms = static_cast<std::uint64_t>(std::numeric_limits<std::uint32_t>::max()) + 1U;
+  check(!r19_encode_grant_reservation_frame(changed, true, 1U, wire), "wire uptime overflow not truncated");
+}
+
+void causal_fences() {
+  Pair p{}; p.held(); p.released();
+  check(p.ground.on_ground_grant(640U, 2U, 500U), "fresh RF Grant within original500");
+  check(!p.ground.negotiation_allowed(601U), "Groundguard alone cannot substitute Vehicle physicaltail");
+  check(p.vehicle.on_tail(640U, 2U, 7U, 9U, 780U), "actual550ms local Grant drain callback");
+  pop(p.vehicle, Op::TailReady);
+  auto permit = tuple_command(Op::TailPermitGround, Role::Ground, 22U, 1U);
+  permit.device_ms = 780U;
+  check(p.ground.handle_command(permit, 800U), "causal peer-tail permit received");
+  check(!p.ground.negotiation_allowed(899U) && p.ground.negotiation_allowed(900U),
+        "second causal100ms fence independent of GroundGrant guard");
+  check(p.vehicle.on_vehicle_vcbn(640U, 2U, 1280U) && !p.vehicle.failed(),
+        "complete canonical VCBN at actualP+500 inclusive");
+  check(p.ground.snapshot().ground_t0_ms == 200U,
+        "tail permit and guard never rebase original Groundt0");
+  Pair late{}; late.held(); late.released();
+  check(late.vehicle.on_tail(640U, 2U, 7U, 9U, 780U), "late fixture physicaltail");
+  check(!late.vehicle.on_vehicle_vcbn(640U, 2U, 1281U) && late.vehicle.failed(),
+        "VehicleP+501 rejected");
+  Pair missing{}; missing.held();
+  check(!missing.ground.on_ground_grant(640U, 2U, 701U), "Groundt0+501 rejected");
+  Pair edge{}; edge.held();
+  check(edge.ground.on_ground_grant(640U, 2U, 700U), "Groundt0+500 inclusive");
+}
+
+void refusals_and_record() {
+  R19GrantReservationController late_prepare{};
+  check(late_prepare.initialize(Role::Vehicle,22U,1U,100U), "late prepare init");
+  check(late_prepare.handle_command(command(Op::HelloRequest,Role::Vehicle,0U,0U),101U),
+        "late prepare hello");
+  pop(late_prepare,Op::HelloReply);
+  auto preparation=command(Op::PrepareVehicle,Role::Vehicle,22U,1U);
+  preparation.grant_session=640U;preparation.grant_cycle=1U;
+  check(late_prepare.handle_command(preparation,102U), "late prepare requested");
+  check(!late_prepare.on_prepared(640U,2U,7U,9U,8602U,8102U),
+        "expired preparation cannot be revived by a later callback");
+  Pair stale_tail{};stale_tail.held();
+  check(stale_tail.ground.on_ground_grant(640U,2U,500U), "stale tail fixture Grant");
+  auto late_permit=tuple_command(Op::TailPermitGround,Role::Ground,22U,1U);
+  late_permit.device_ms=780U;
+  check(!stale_tail.ground.handle_command(late_permit,2501U),
+        "late command cannot skip the original two-second tail wait");
+  Pair stale_request{};
+  check(!stale_request.ground.on_ground_held(8111U,640U,1U,8111U),
+        "expired Ground binding cannot be revived by an actual-held callback");
+  Pair expired{};
+  check(!expired.vehicle.tick(850U) && !expired.vehicle.should_release(),
+        "hold exclusive deadline expires without action reissue");
+  Pair epoch{};
+  check(!epoch.ground.observe_local_epoch(1U, 120U), "local epoch change fails");
+  const auto frozen = epoch.ground.snapshot();
+  check(!epoch.ground.tick(121U) && epoch.ground.snapshot().event_count == frozen.event_count,
+        "first failure immutable, no postfault journal rewrite");
+  Pair replay{}; replay.held(); replay.released();
+  auto command_again = tuple_command(Op::ReleaseGrant, Role::Vehicle, 22U, 1U);
+  command_again.device_ms = 200U;
+  check(!replay.vehicle.handle_command(command_again, 240U), "release replay never writes twice");
+  Pair wrong{}; wrong.held();
+  auto bad = tuple_command(Op::TailPermitGround, Role::Ground, 22U, 1U);
+  ++bad.writer_generation;
+  check(!wrong.ground.handle_command(bad, 250U), "changed writer generation rejected");
+  Pair order{}; order.held();
+  check(!order.vehicle.on_tail(640U, 2U, 7U, 9U, 225U), "tail cannot precede actual UART accept");
+  R19GrantReservationRecord record{};
+  check(sizeof(record) == 512U, "record512 exact ABI");
+  constexpr std::array<std::uint32_t, 4U> build{{1U,2U,3U,4U}};
+  constexpr std::array<std::uint32_t, 4U> boot{{11U,0U,7U,8U}};
+  check(record.initialize(Role::Ground, build, boot) && record.observe(frozen),
+        "record stable identity initialization and controller snapshot");
+  check(record.words[2U] == 0x52313952U && record.words[14U] == 512U &&
+            record.words[13U] == 7U && record.words[31U] == 0U,
+        "record magic, firstfault freeze and reserved bytes");
+  const auto sequence = record.words[1U];
+  check(record.observe(epoch.ground.snapshot()) && record.words[1U] == sequence,
+        "frozen record not rewritten by repeated observer calls");
+}
+void strict_boundaries_and_record_validation() {
+  Pair delayed{};
+  check(!delayed.ground.on_ground_held(200U,640U,1U,701U),
+        "delayed callback cannot publish an already-expired original held t0");
+  Pair near_wrap{};near_wrap.held();near_wrap.released();
+  check(near_wrap.ground.on_ground_grant(640U,2U,500U), "gate fixture actual Grant");
+  auto permit=tuple_command(Op::TailPermitGround,Role::Ground,22U,1U);
+  permit.device_ms=780U;
+  check(near_wrap.ground.handle_command(permit,800U), "gate fixture TailPermit");
+  check(!near_wrap.ground.negotiation_allowed(
+          static_cast<std::uint64_t>(std::numeric_limits<std::uint32_t>::max())+1U),
+        "permission query cannot authorize wire-time overflow");
+  constexpr std::array<std::uint32_t,4U> build{{1U,2U,3U,4U}};
+  constexpr std::array<std::uint32_t,4U> boot{{11U,0U,7U,8U}};
+  const auto pristine=near_wrap.ground.snapshot();
+  for(unsigned kind=0U;kind<6U;++kind) {
+    R19GrantReservationRecord record{};
+    check(record.initialize(Role::Ground,build,boot), "malformed record fixture init");
+    auto changed=pristine;
+    switch(kind) {
+      case 0U:changed.state=static_cast<State>(15U);break;
+      case 1U:changed.journal[0U].event=16U;break;
+      case 2U:changed.journal[0U].state_reason=15U;break;
+      case 3U:changed.journal[0U].state_reason=22U<<16U;break;
+      case 4U:changed.journal[1U].timestamp_ms=changed.journal[0U].timestamp_ms-1U;break;
+      default:changed.journal[0U].event=15U;break;
+    }
+    check(!record.observe(changed) && record.words[1U]==2U,
+          "invalid enum/order/premature fault snapshot rejected without write");
+  }
+  R19GrantReservationController wrong_reply{};
+  check(wrong_reply.initialize(Role::Vehicle,22U,1U,100U), "reply validation init");
+  check(!wrong_reply.note_reply_completed(Op::PrepareVehicle,101U),
+        "request opcode cannot be reported as USB reply commit");
+}
+void diagnostic_scope_and_journal() {
+  constexpr std::array<std::uint32_t,4U> build{{1U,2U,3U,4U}};
+  constexpr std::array<std::uint32_t,4U> boot{{11U,0U,7U,8U}};
+  R19GrantReservationController c{};
+  check(c.initialize(Role::Ground,11U,0U,100U), "journal epoch-zero init");
+  check(c.handle_command(command(Op::HelloRequest,Role::Ground,0U,0U),101U),
+        "journal Hello remains pending");
+  check(c.tick(14100U) && c.peek_reply()==nullptr,
+        "Hello waits real baseline; runner owns preparation timeout, not fake RF event");
+  check(c.on_ground_baseline(640U,0U,14101U), "actual baseline cycle zero is valid");
+  pop(c,Op::HelloReply);
+  for(std::uint64_t now=14102U;now<14122U;++now)
+    check(c.note_reply_completed(Op::HelloReply,now), "bounded journal observed reply event");
+  check(c.snapshot().event_count==22U && c.snapshot().journal_count==12U &&
+        c.snapshot().journal_dropped==10U, "journal counts first8 plus last4 retention");
+  for(std::size_t i=0U;i<8U;++i)
+    check(c.snapshot().journal[i].timestamp_ms==(i==0U?101U:14100U+i),
+          "journal preserves first eight chronological events");
+  for(std::size_t i=8U;i<12U;++i)
+    check(c.snapshot().journal[i].timestamp_ms==14110U+i,
+          "journal retains four most recent events in order");
+  check(!c.abort(Reason::ExternalFault,14122U,99U), "external stop freezes first failure");
+  const auto frozen=c.snapshot();
+  check(frozen.journal[11U].event==15U && frozen.journal[11U].aux==99U &&
+        frozen.reason==Reason::ExternalFault && frozen.journal_dropped==11U,
+        "first failure is final retained journal entry without reserved-word reuse");
+  R19GrantReservationRecord record{};
+  check(record.initialize(Role::Ground,build,boot) && record.observe(frozen),
+        "retained journal serializes under strict build/boot binding");
+  check(record.words[17U]==(12U|(11U<<16U)) && record.words[120U]==15U &&
+        record.words[127U]==99U && record.words[1U]%2U==0U && record.words[0U]==0U,
+        "512-byte stable seqlock journal matches exact header and final event");
+  for(unsigned mutation=0U;mutation<5U;++mutation) {
+    Pair p{};
+    auto m=tuple_command(Op::TailPermitGround,Role::Ground,22U,1U);
+    p.held();m.device_ms=780U;
+    switch(mutation) {
+      case 0U:++m.reader_session;break;
+      case 1U:++m.slot_nonce;break;
+      case 2U:++m.boot_id;break;
+      case 3U:++m.usb_epoch;break;
+      default:++m.action_token;break;
+    }
+    check(!p.ground.handle_command(m,250U) && p.ground.failed() &&
+          !p.ground.negotiation_allowed(500U), "scope/peer/token mutation cannot open negotiation");
+  }
+  Pair premature{};premature.held();premature.released();
+  check(!premature.vehicle.on_tail(640U,2U,7U,9U,779U), "service floor549 never physical completion");
+  Pair causal{};causal.held();
+  auto permit=tuple_command(Op::TailPermitGround,Role::Ground,22U,1U);
+  permit.device_ms=780U;
+  check(causal.ground.handle_command(permit,300U), "peer claim may arrive before local RF observation");
+  check(!causal.ground.negotiation_allowed(450U), "peer claim alone cannot replace accepted RF Grant");
+  check(causal.ground.on_ground_grant(640U,2U,500U) &&
+        !causal.ground.negotiation_allowed(599U) && causal.ground.negotiation_allowed(600U),
+        "both independent local hundred-ms fences remain mandatory");
+  check(causal.ground.on_ground_negotiation_started(600U) && causal.ground.tick(30000U),
+        "actual negotiation start retires only reservation phase timers");
+  Pair immutable{};
+  check(!immutable.vehicle.tick(112U) && immutable.vehicle.snapshot().reason==Reason::ClockRegression,
+        "local clock regression fails against original timestamp");
+  const auto original=immutable.vehicle.snapshot();
+  check(!immutable.vehicle.abort(Reason::ExternalFault,120U,321U) &&
+        immutable.vehicle.snapshot().event_count==original.event_count &&
+        immutable.vehicle.snapshot().reason==Reason::ClockRegression,
+        "later abort cannot overwrite original first failure");
+}
+}  // namespace
+int main() {
+  codec(); causal_fences(); refusals_and_record(); strict_boundaries_and_record_validation();
+  diagnostic_scope_and_journal();
+  std::cout << "r19-grant-reservation checks=" << checks << " failures=" << failures
+            << " diagnostic_dual_usb_only=1 product_RF_reservation=0\n";
+  return failures == 0U ? 0 : 1;
+}
