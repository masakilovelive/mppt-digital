+  BoundLocal=5U, BoundPeer=6U, GroundHeld=7U, ReleaseGrant=8U,
+  GrantWritten=9U, GrantObserved=10U, TailObserved=11U, TailPermit=12U,
+  Started=13U, ReplyCommitted=14U, Failure=15U
