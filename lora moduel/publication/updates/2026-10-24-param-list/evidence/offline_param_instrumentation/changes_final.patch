+  $t=($Value -bxor ($Crc -band 255)) -band 255
+  $t=($t -bxor ($t -shl 4)) -band 255
+  return [uint16]((($Crc -shr 8) -bxor ($t -shl 8) -bxor ($t -shl 3) -bxor ($t -shr 4)) -band 65535)
+}
