  "causal_findings": [
    {
      "claim": "Vehicle initial diagnostic USB 31-byte pending failure necessarily stops all product Heartbeat or causes Ground AUX fault",
      "verdict": "FALSIFIED_BY_OBSERVED_COUNTEREXAMPLE",
      "evidence": "The same immutable Vehicle pattern (63 accepted, 31 pending, publish 3 / pickup 2, source 5227, same candidate) occurs in all three boots. The 233030 boot nevertheless records Ground AUX fault 0 and 37 product Heartbeats, with first product local USB completion in 505 us.",
      "scope_limit": "This does not exonerate every USB timing interaction; it rejects only a necessary, unconditional consequence of the observed Vehicle failure."
    },
    {
      "claim": "A Ground diagnostic USB failure is a necessary earlier trigger of the Ground AUX safety fault",
      "verdict": "FALSIFIED_FOR_THE_RECORDED_FIRST_FAILURE",
      "evidence": "In 155139 the AUX fault precedes Ground first diagnostic failure by 40,534,825 us. The later diagnostic failure has ring 50 rather than the initial 31-byte pattern. In the latest run, the initial AUX IRQ LOW also precedes Ground USB failure by 849,509 us.",
      "scope_limit": "Unrecorded successful or nonterminal USB activity may affect scheduling. A failed USB call can coincide with AUX observation delay; this comparison does not exclude that narrower mechanism."
    },
    {
      "claim": "Current failure is produced by the new PARAM_REQUEST_LIST load",
      "verdict": "NOT_SUPPORTED_REQUEST_NOT_SENT",
      "evidence": "Latest request_attempts is 0, product enqueue is false, and the same AUX fault/approximately 5-second observed LOW existed in 155139 before the new request diagnostic."
    },
    {
      "claim": "Clock/READY/ARM implementation is absent in the failing runs",
      "verdict": "NOT_SUPPORTED_BY_CURRENT_RECORDS",
      "evidence": "Both role clock replies validate and Ground READY/ARM occur in all three runs. In the two AUX-fault boots, fault is earlier than ARM by 692,664 us and 307,619 us respectively. ARM success does not reset an already latched backend fault."
    },
    {
      "claim": "The same firmware can exhibit different AUX transaction durations",
      "verdict": "OBSERVED",
      "evidence": "For the first Ground UART transaction, the two failure boots retain LOW-to-HIGH intervals 5,045,248 us and 5,057,498 us; the no-AUX-fault boot retains 529,621 us. These are per-boot durations, not cross-boot absolute-time differences.",
      "scope_limit": "Only observed GPIO transitions are established. E220 RF airtime, physical LOW continuity, missed interrupts, power integrity and the external cause are not proved by these records."
    }
  ],
