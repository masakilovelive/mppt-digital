diff --git a/firmware/high_speed/r19_diagnostic_usb_failure_record.hpp b/firmware/high_speed/r19_diagnostic_usb_failure_record.hpp
new file mode 100644
index 0000000..8ff34f7
--- /dev/null
+++ b/firmware/high_speed/r19_diagnostic_usb_failure_record.hpp
@@ -0,0 +1,182 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <type_traits>
+#include <HWCDCR19Diagnostic.h>
+#include "r19_runtime_stage_record.hpp"
+
+namespace vc_lora::experimental {
+
+inline constexpr std::uint32_t r19_diagnostic_usb_failure_magic = 0x44313955U;
+inline constexpr std::uint32_t r19_diagnostic_usb_failure_schema = 1U;
+enum class R19DiagnosticUsbWrapperFlag : std::uint32_t {
+  ApiCalled=1U, RawReturn=2U, EndpointReady=4U, WithinDeadline=8U,
+  CallContextMatches=16U,
+};
+
+// This independent diagnostic record does not change the384-byte product
+// Heartbeat ABI. Caller clocks are continuous MCU64 microseconds. SDK clocks
+// retain their own millis32 semantics and are never substituted for them.
+struct R19DiagnosticUsbFailureEvidence {
+  std::uint32_t reason{0U}, source_line{0U}, action{0U}, diagnostic_sequence{0U};
+  std::uint32_t bootstrap_flags{0U}, expected_epoch{0U}, observed_epoch{0U};
+  std::uint32_t budget_ms{0U}, attempt_id{0U}, wrapper_flags{0U};
+  std::uint64_t failure_observed_us{0U}, started_us{0U}, finished_us{0U}, deadline_us{0U};
+  std::uint32_t expected_frame_bytes{0U}, accepted_frame_bytes{0U};
+  R19HwcdcFlushCallEvidence sdk{};
+};
+
+struct R19DiagnosticUsbFailureSnapshot final : R19DiagnosticUsbFailureEvidence {
+  std::uint32_t sequence{0U}, magic{0U}, schema{0U}, flags{0U};
+  R19RuntimeStageRole role{R19RuntimeStageRole::Invalid};
+  R19RuntimeBuildFingerprint build_fingerprint{};
+  std::array<std::uint32_t,4U> boot_instance{};
+  [[nodiscard]] bool valid_header() const noexcept {
+    return magic==r19_diagnostic_usb_failure_magic &&
+        schema==r19_diagnostic_usb_failure_schema &&
+        (role==R19RuntimeStageRole::Ground || role==R19RuntimeStageRole::Vehicle) &&
+        (boot_instance[0]|boot_instance[1]|boot_instance[2]|boot_instance[3])!=0U &&
+        (flags&1U)!=0U && (flags&~3U)==0U;
+  }
+  [[nodiscard]] bool failure_latched() const noexcept { return valid_header() && (flags&2U)!=0U; }
+  [[nodiscard]] bool api_called() const noexcept { return (wrapper_flags&1U)!=0U; }
+  [[nodiscard]] bool sdk_context_matches() const noexcept { return (wrapper_flags&16U)!=0U; }
+};
+
+struct R19DiagnosticUsbFailureRecordTestAccess;
+
+// JTAG-only, one application-task writer, no ISR/heap/locks/USB writes.
+// The first failure body and its identity are permanently immutable after
+// latch. A seqlock prevents an interrupted writer from presenting mixed data.
+class alignas(std::uint32_t) R19DiagnosticUsbFailureRecord final {
+ public:
+  static constexpr std::size_t storage_word_count=64U;
+  R19DiagnosticUsbFailureRecord() noexcept=default;
+  R19DiagnosticUsbFailureRecord(const R19DiagnosticUsbFailureRecord&)=delete;
+  R19DiagnosticUsbFailureRecord& operator=(const R19DiagnosticUsbFailureRecord&)=delete;
+
+  [[nodiscard]] bool initialize(R19RuntimeStageRole role,
+      const R19RuntimeBuildFingerprint& build,
+      const std::array<std::uint32_t,4U>& boot) noexcept {
+    if(words_[2U]!=0U ||
+        (role!=R19RuntimeStageRole::Ground && role!=R19RuntimeStageRole::Vehicle) ||
+        (boot[0]|boot[1]|boot[2]|boot[3])==0U) return false;
+    begin_write();
+    for(std::size_t n=2U;n<storage_word_count;++n) words_[n]=0U;
+    words_[2U]=r19_diagnostic_usb_failure_magic;
+    words_[3U]=r19_diagnostic_usb_failure_schema;
+    words_[4U]=static_cast<std::uint32_t>(role);
+    for(std::size_t n=0U;n<4U;++n){words_[5U+n]=build[n];words_[9U+n]=boot[n];}
+    words_[13U]=1U;
+    commit_write();
+    return true;
+  }
+
+  [[nodiscard]] bool latch_first_failure(const R19DiagnosticUsbFailureEvidence& e) noexcept {
+    if(words_[2U]!=r19_diagnostic_usb_failure_magic ||
+        words_[3U]!=r19_diagnostic_usb_failure_schema || (words_[13U]&3U)!=1U ||
+        !valid_evidence(e)) return false;
+    begin_write();
+    words_[14U]=e.reason;words_[15U]=e.source_line;words_[16U]=e.action;
+    words_[17U]=e.diagnostic_sequence;words_[18U]=e.bootstrap_flags;
+    words_[19U]=e.expected_epoch;words_[20U]=e.observed_epoch;
+    words_[21U]=e.budget_ms;words_[22U]=e.attempt_id;words_[23U]=e.wrapper_flags;
+    write_u64(24U,e.failure_observed_us);write_u64(26U,e.started_us);
+    write_u64(28U,e.finished_us);write_u64(30U,e.deadline_us);
+    std::array<std::uint32_t,24U> sdk_words{};
+    std::memcpy(sdk_words.data(),&e.sdk,sizeof(e.sdk));
+    for(std::size_t n=0U;n<sdk_words.size();++n)words_[32U+n]=sdk_words[n];
+    words_[56U]=e.expected_frame_bytes;words_[57U]=e.accepted_frame_bytes;
+    fence();words_[13U]=3U;commit_write();
+    return true;
+  }
+
+  [[nodiscard]] bool try_snapshot(R19DiagnosticUsbFailureSnapshot& output,
+      std::uint32_t maximum_attempts=8U) const noexcept {
+    for(std::uint32_t n=0U;n<maximum_attempts;++n){
+      if(words_[0U]!=0U)continue;
+      fence();const auto before=words_[1U];if((before&1U)!=0U)continue;
+      std::array<std::uint32_t,storage_word_count> raw{};
+      for(std::size_t k=0U;k<storage_word_count;++k)raw[k]=words_[k];
+      fence();if(words_[0U]!=0U || words_[1U]!=before || (before&1U)!=0U)continue;
+      R19DiagnosticUsbFailureSnapshot s{};
+      s.sequence=before;s.magic=raw[2U];s.schema=raw[3U];
+      s.role=static_cast<R19RuntimeStageRole>(raw[4U]);s.flags=raw[13U];
+      for(std::size_t k=0U;k<4U;++k){s.build_fingerprint[k]=raw[5U+k];s.boot_instance[k]=raw[9U+k];}
+      s.reason=raw[14U];s.source_line=raw[15U];s.action=raw[16U];
+      s.diagnostic_sequence=raw[17U];s.bootstrap_flags=raw[18U];
+      s.expected_epoch=raw[19U];s.observed_epoch=raw[20U];s.budget_ms=raw[21U];
+      s.attempt_id=raw[22U];s.wrapper_flags=raw[23U];
+      s.failure_observed_us=read_u64(raw,24U);s.started_us=read_u64(raw,26U);
+      s.finished_us=read_u64(raw,28U);s.deadline_us=read_u64(raw,30U);
+      std::memcpy(&s.sdk,raw.data()+32U,sizeof(s.sdk));
+      s.expected_frame_bytes=raw[56U];s.accepted_frame_bytes=raw[57U];
+      output=s;return true;
+    }
+    return false;
+  }
+
+ private:
+  friend struct R19DiagnosticUsbFailureRecordTestAccess;
+  static bool valid_evidence(const R19DiagnosticUsbFailureEvidence& e) noexcept {
+    const bool called=(e.wrapper_flags&1U)!=0U;
+    const bool raw=(e.wrapper_flags&2U)!=0U;
+    const bool matches=(e.wrapper_flags&16U)!=0U;
+    if(e.reason==0U || e.reason>30U || e.action>3U || e.diagnostic_sequence>255U ||
+        (e.bootstrap_flags&~15U)!=0U || (e.wrapper_flags&~31U)!=0U ||
+        e.accepted_frame_bytes>e.expected_frame_bytes ||
+        e.finished_us<e.started_us || e.failure_observed_us<e.finished_us ||
+        (!called && (raw || matches)) ||
+        ((e.wrapper_flags&8U)!=0U &&
+          (e.deadline_us==0U || e.finished_us>e.deadline_us))) return false;
+    std::array<std::uint32_t,24U> sdk{};
+    std::memcpy(sdk.data(),&e.sdk,sizeof(e.sdk));
+    if(e.sdk.schema!=1U)return false;
+    bool absent=true;
+    for(std::size_t n=1U;n<sdk.size();++n)absent=absent && sdk[n]==0U;
+    if(!called)return absent;
+    // No matching call-local SDK value is unknown, not a zero/healthy FIFO.
+    if(absent)return !matches;
+    if((e.sdk.validity_flags&0x13U)!=0x13U ||
+        (e.sdk.validity_flags&~255U)!=0U ||
+        e.sdk.terminal_reason==0U || e.sdk.terminal_reason>6U ||
+        e.sdk.raw_return>1U ||
+        ((e.sdk.terminal_reason==1U)!=(e.sdk.raw_return==1U)))return false;
+    if((e.sdk.validity_flags&8U)!=0U){
+      if((e.sdk.state_flags&~0x3FFFU)!=0U ||
+          (e.sdk.flush_blocker_mask&~0xFFU)!=0U)return false;
+    }else{
+      if((e.sdk.validity_flags&128U)!=0U)return false;
+      for(std::size_t n=12U;n<sdk.size();++n)if(sdk[n]!=0U)return false;
+    }
+    if(matches && (e.sdk.transaction_token!=e.diagnostic_sequence+1U ||
+        e.sdk.attempt_id!=e.attempt_id ||
+        e.sdk.expected_loss_epoch!=e.expected_epoch ||
+        e.sdk.timeout_ms!=e.budget_ms || e.sdk.raw_return!=(raw?1U:0U)))return false;
+    return true;
+  }
+  static void fence() noexcept {std::atomic_signal_fence(std::memory_order_seq_cst);}
+  void begin_write() noexcept {words_[0U]=1U;fence();words_[1U]=(words_[1U]&~1U)+1U;fence();}
+  void commit_write() noexcept {fence();words_[1U]=(words_[1U]|1U)+1U;fence();words_[0U]=0U;}
+  void write_u64(std::size_t n,std::uint64_t value) noexcept {
+    words_[n]=static_cast<std::uint32_t>(value);words_[n+1U]=static_cast<std::uint32_t>(value>>32U);
+  }
+  static std::uint64_t read_u64(const std::array<std::uint32_t,storage_word_count>& w,
+      std::size_t n) noexcept {return w[n]|(static_cast<std::uint64_t>(w[n+1U])<<32U);}
+  // words0 writer,1 sequence,2 magic,3 schema,4 role,5..8 build,9..12 boot,
+  //13 initialized/latched,14 reason,15 source,16 action,17 wire diagnostic seq,
+  //18 bootstrap flags,19 expected epoch,20 observed epoch,21 budget,22 attempt,
+  //23 wrapper flags,24..25 failure MCUus,26..27 start,28..29 return,30..31 deadline,
+  //32..55 SDK96-byte POD,56 expected frame bytes,57 accepted bytes,58..63 zero.
+  volatile std::uint32_t words_[storage_word_count]{};
+};
+static_assert(sizeof(R19HwcdcFlushCallEvidence)==96U);
+static_assert(std::is_trivially_copyable_v<R19HwcdcFlushCallEvidence>);
+static_assert(sizeof(R19DiagnosticUsbFailureRecord)==256U);
+static_assert(alignof(R19DiagnosticUsbFailureRecord)==4U);
+static_assert(std::is_standard_layout_v<R19DiagnosticUsbFailureRecord>);
+} // namespace vc_lora::experimental
diff --git a/tools/read_r19_diagnostic_usb_failure_record.ps1 b/tools/read_r19_diagnostic_usb_failure_record.ps1
new file mode 100644
index 0000000..51be6e6
--- /dev/null
+++ b/tools/read_r19_diagnostic_usb_failure_record.ps1
@@ -0,0 +1,126 @@
+[CmdletBinding()]
+param([switch]$ImportOnly,[switch]$DecodeOnly,[switch]$TestOnly,
+  [string]$FixturePath,[string]$OutputPath)
+# Pure definitions on import: no hardware, process inventory, clock, or I/O.
+function ConvertFrom-R19DiagnosticUsbFailureRecord {
+  param([byte[]]$First,[byte[]]$Second,
+    [ValidateSet('ground','vehicle')][string]$ExpectedRole,
+    [AllowNull()][object[]]$ExpectedFingerprint,[AllowNull()][object[]]$ExpectedBoot)
+  $ErrorActionPreference='Stop'
+  Set-StrictMode -Version Latest
+  function Require([bool]$v,[string]$message){if(-not$v){throw $message}}
+  function U64([uint32[]]$w,[int]$n){[uint64]$w[$n]+[uint64]$w[$n+1]*[uint64]4294967296}
+  function Identity([object[]]$expected,[uint32[]]$w,[int]$offset){
+    Require (@($expected).Count-eq4) 'Identity requires four uint32 words'
+    for($n=0;$n-lt4;$n++){
+      [decimal]$value=$expected[$n]
+      Require ($value-ge0-and$value-le[uint32]::MaxValue-and$value-eq[math]::Floor($value)) 'Invalid identity word'
+      Require ([uint32]$value-eq$w[$offset+$n]) 'Identity mismatch'
+    }
+  }
+  Require ($ExpectedRole-ceq'ground'-or$ExpectedRole-ceq'vehicle') 'Unknown expected role'
+  Require ($null-ne$First-and$null-ne$Second-and$First.Length-eq256-and$Second.Length-eq256) 'Record size must be exactly256 bytes'
+  for($n=0;$n-lt256;$n++){Require ($First[$n]-eq$Second[$n]) 'Two reads differ'}
+  [uint32[]]$w=[uint32[]]::new(64)
+  for($n=0;$n-lt64;$n++){$w[$n]=[BitConverter]::ToUInt32($First,4*$n)}
+  Require ($w[0]-eq0-and($w[1]-band1)-eq0) 'Unstable seqlock sample'
+  Require ($w[2]-eq0x44313955-and$w[3]-eq1) 'Unknown record magic/schema'
+  $roleCode=if($ExpectedRole-ceq'ground'){1}else{2}
+  Require ($w[4]-eq$roleCode) 'Role mismatch'
+  if($null-ne$ExpectedFingerprint){Identity $ExpectedFingerprint $w 5}
+  if($null-ne$ExpectedBoot){Identity $ExpectedBoot $w 9}
+  Require (($w[9]-bor$w[10]-bor$w[11]-bor$w[12])-ne0) 'Zero boot identity'
+  Require (($w[13]-band1)-ne0-and($w[13]-band0xFFFFFFFCL)-eq0) 'Unknown or uninitialized flags'
+  for($n=58;$n-lt64;$n++){Require ($w[$n]-eq0) 'Reserved words must be zero'}
+  $latched=($w[13]-band2)-ne0
+  $called=($w[23]-band1)-ne0
+  $raw=($w[23]-band2)-ne0
+  $context=($w[23]-band16)-ne0
+  $rawReturn=$null
+  [string[]]$names=@('schema','validity_flags','transaction_token','attempt_id',
+    'terminal_reason','timeout_ms','expected_loss_epoch','started_ms','finished_ms',
+    'lock_wait_ms','elapsed_ms','raw_return','state_flags','observed_loss_epoch',
+    'ring_pending_bytes','stash_pending_bytes','publish_generation','pickup_generation',
+    'raw_interrupt_status','interrupt_enable_mask','flush_blocker_mask',
+    'snapshot_started_ms','snapshot_finished_ms','snapshot_duration_us')
+  $sdk=[ordered]@{}
+  for($n=0;$n-lt24;$n++){$sdk[$names[$n]]=$w[32+$n]}
+  $sdkAbsent=$true
+  for($n=33;$n-le55;$n++){if($w[$n]-ne0){$sdkAbsent=$false}}
+  if($latched){
+    Require ($w[14]-ge1-and$w[14]-le30-and$w[16]-le3-and$w[17]-le255) 'Unknown diagnostic reason/action/sequence'
+    Require (($w[18]-band0xFFFFFFF0L)-eq0-and($w[23]-band0xFFFFFFE0L)-eq0) 'Unknown bootstrap/wrapper flags'
+    Require ($w[57]-le$w[56]) 'Accepted bytes exceed frame size'
+    Require ((U64 $w 28)-ge(U64 $w 26)-and(U64 $w 24)-ge(U64 $w 28)) 'Backward MCU timestamps'
+    if(($w[23]-band8)-ne0){Require ((U64 $w 30)-ne0-and(U64 $w 28)-le(U64 $w 30)) 'False within-deadline witness'}
+    Require ($called-or(-not$raw-and-not$context)) 'Uncalled API cannot claim result/context'
+    Require ($sdk.schema-eq1) 'Unknown SDK evidence schema'
+    if(-not$called){Require $sdkAbsent 'Uncalled API SDK evidence must be absent'}
+    elseif($sdkAbsent){Require (-not$context) 'Absent SDK cannot match current call'}
+    else{
+      Require (($sdk.validity_flags-band0x13)-eq0x13-and($sdk.validity_flags-band0xFFFFFF00L)-eq0) 'Incomplete or unknown SDK evidence'
+      Require ($sdk.terminal_reason-ge1-and$sdk.terminal_reason-le6-and$sdk.raw_return-le1) 'Unknown SDK terminal/result'
+      Require (($sdk.terminal_reason-eq1)-eq($sdk.raw_return-eq1)) 'SDK terminal/result contradiction'
+      if(($sdk.validity_flags-band8)-ne0){
+        Require (($sdk.state_flags-band0xFFFFC000L)-eq0-and($sdk.flush_blocker_mask-band0xFFFFFF00L)-eq0) 'Unknown FIFO state/wait reason'
+      }else{
+        Require (($sdk.validity_flags-band128)-eq0) 'Lockless snapshot cannot be unobserved'
+        for($n=44;$n-le55;$n++){Require ($w[$n]-eq0) 'Unobserved SDK snapshot must be absent'}
+      }
+      if($context){
+        Require ($sdk.transaction_token-eq$w[17]+1-and$sdk.attempt_id-eq$w[22]-and$sdk.timeout_ms-eq$w[21]-and$sdk.expected_loss_epoch-eq$w[19]) 'SDK context mismatch'
+        Require ($sdk.raw_return-eq$(if($raw){1}else{0})) 'SDK/wrapper raw result mismatch'
+      }
+    }
+    if($called){$rawReturn=$raw}
+  }else{for($n=14;$n-le57;$n++){Require ($w[$n]-eq0) 'Unlatched evidence must be zero'}}
+  $sdkObserved=$latched-and$called-and-not$sdkAbsent
+  $snapshotObserved=$sdkObserved-and($sdk.validity_flags-band8)-ne0
+  $sdk['call_context_matches']=$context
+  $sdk['snapshot_observed']=[bool]$snapshotObserved
+  $sdk['lock_acquired']=[bool]($sdkObserved-and($sdk.validity_flags-band4)-ne0)
+  $sdk['matching_terminal_snapshot']=[bool]($context-and$snapshotObserved)
+  $terminalNames=@('NotObserved','Success','NullRing','NullLock','LockTimeout','LoopTimeout','EpochAbort')
+  $sdk['terminal_name']=if($sdkObserved){$terminalNames[$sdk.terminal_reason]}else{'NotObserved'}
+  if(-not$sdkObserved){$sdk['raw_return']=$null}
+  $sha=[Security.Cryptography.SHA256]::Create()
+  try{$hash=([BitConverter]::ToString($sha.ComputeHash($First))).Replace('-','')}finally{$sha.Dispose()}
+  [pscustomobject][ordered]@{
+    schema='vc-lora-r19-diagnostic-usb-failure-decoded-v1';result='PASS';mode='offline-only'
+    hardware_interaction=$false;raw_size_bytes=256;raw_sha256=$hash;record_schema=$w[3]
+    sequence=$w[1];role=$ExpectedRole;build_fingerprint=@($w[5..8]);boot_instance=@($w[9..12])
+    expected_identity_bound=[bool]($null-ne$ExpectedFingerprint-and$null-ne$ExpectedBoot)
+    failure_latched=$latched
+    first_failure=[ordered]@{
+      reason=$w[14];source_line=$w[15];action=$w[16];diagnostic_sequence=$w[17]
+      bootstrap_flags=$w[18];expected_epoch=$w[19];observed_epoch=$w[20];budget_ms=$w[21]
+      attempt_id=$w[22];wrapper_flags=$w[23];api_called=$called;raw_return=$rawReturn
+      sdk_context_matches=$context;failure_observed_us=(U64 $w 24).ToString()
+      started_us=(U64 $w 26).ToString();finished_us=(U64 $w 28).ToString();deadline_us=(U64 $w 30).ToString()
+      expected_frame_bytes=$w[56];accepted_frame_bytes=$w[57];sdk=$sdk
+    }
+    physical_fifo_fault_proven=$false;acceptance_authorized=$false;deployment_authorized=$false
+    limitations=@(
+      'Immutable diagnostic terminal-call evidence, not the product Heartbeat384-byte record or a later live FIFO snapshot.',
+      'A nonmatching/absent SDK context is unknown for the failed transaction and cannot locate a physical FIFO fault.',
+      'SnapshotWithoutTxLock records observed shared state without proving caller ownership.',
+      'MCU64 timestamps and SDK millis32 are distinct; no PC/MCU ordering or guaranteed offset is inferred.',
+      'Stable decoding alone cannot prove hardware acquisition provenance, host receipt, RF delivery, or product acceptance.'
+    )
+  }
+}
+if($ImportOnly){
+  if($DecodeOnly-or$TestOnly-or$FixturePath-or$OutputPath){throw 'ImportOnly forbids CLI inputs and outputs'}
+  return
+}
+try{
+  if(-not($DecodeOnly-or$TestOnly)){throw 'DecodeOnly or TestOnly required; no live hardware mode exists'}
+  $f=Get-Content -LiteralPath $FixturePath -Raw|ConvertFrom-Json
+  if($f.schema-cne'vc-lora-r19-diagnostic-usb-failure-fixture-v1'){throw 'Unknown fixture schema'}
+  if(-not$f.PSObject.Properties['build_fingerprint']-or-not$f.PSObject.Properties['boot_instance']){throw 'CLI fixture requires explicit fingerprint and boot'}
+  $d=ConvertFrom-R19DiagnosticUsbFailureRecord -First ([Convert]::FromBase64String($f.first_read_base64)) -Second ([Convert]::FromBase64String($f.second_read_base64)) -ExpectedRole $f.role -ExpectedFingerprint $f.build_fingerprint -ExpectedBoot $f.boot_instance
+  $json=$d|ConvertTo-Json -Depth 12
+  if($OutputPath){$json|Set-Content -LiteralPath $OutputPath -Encoding utf8}
+  $json
+  exit 0
+}catch{Write-Error -ErrorAction Continue ('OFFLINE_DECODE_REJECTED: '+$_.Exception.Message);exit 1}
diff --git a/tools/r19_usb_role_contract.ps1 b/tools/r19_usb_role_contract.ps1
new file mode 100644
index 0000000..0bfac09
--- /dev/null
+++ b/tools/r19_usb_role_contract.ps1
@@ -0,0 +1,72 @@
+# Definitions only. No device, port, process, clock, or network operation.
+# File fingerprints are sampled only by the explicit source-contract constructor.
+function Assert-R19UsbRoleCapabilityShape {
+  param([object]$Contract)
+  if($null-eq$Contract-or$Contract.schema-cne'vc-lora-r19-usb-role-capabilities-v1'-or
+     $Contract.mode-cne'ExplicitHostArm'-or$Contract.implementation_bound-isnot[bool]-or-not$Contract.implementation_bound){throw 'Missing or unsupported versioned USB role capabilities'}
+  $expectedSources=@('firmware/phase6/vc_lora_phase6_bridge.hpp','firmware/high_speed/r19_diagnostic_usb_failure_record.hpp','tools/r19_usb_role_contract.ps1')
+  $sources=@($Contract.canonical_sources)
+  if($sources.Count-ne$expectedSources.Count){throw 'USB role capability source inventory is incomplete'}
+  foreach($path in $expectedSources){
+    $rows=@($sources|Where-Object{$_.path-ceq$path})
+    if($rows.Count-ne1-or$rows[0].sha256-isnot[string]-or$rows[0].sha256-cnotmatch'^[0-9A-F]{64}$'){throw 'USB role capability source fingerprint is absent or malformed'}
+  }
+  $roles=@($Contract.roles)
+  if($roles.Count-ne2){throw 'USB role capability inventory must contain exactly two roles'}
+  foreach($expected in @(@('vehicle','SyncOnly',$false,$false),@('ground','ExplicitHostArm',$true,$true))){
+    $rows=@($roles|Where-Object{$_.role-ceq$expected[0]})
+    if($rows.Count-ne1){throw 'USB role capability role is missing or duplicated'}
+    $r=$rows[0]
+    foreach($flag in @('clock_request_reply','ready','arm')){if($r.$flag-isnot[bool]){throw 'USB role capability flag must be boolean'}}
+    if(-not$r.clock_request_reply-or$r.effective_mode-cne$expected[1]-or$r.ready-ne$expected[2]-or$r.arm-ne$expected[3]){throw 'USB role capability is unsupported or escalates Vehicle admission'}
+  }
+}
+
+function Get-R19UsbRoleCapabilities {
+  param([string]$RepoRoot,[string]$Mode='ExplicitHostArm',[bool]$Enabled=$false)
+  if(-not$Enabled){return $null}
+  if($Mode-cne'ExplicitHostArm'){throw 'Bound USB role capabilities require ExplicitHostArm diagnostic mode'}
+  $relative=@('firmware/phase6/vc_lora_phase6_bridge.hpp','firmware/high_speed/r19_diagnostic_usb_failure_record.hpp','tools/r19_usb_role_contract.ps1')
+  $bridgePath=Join-Path $RepoRoot $relative[0]
+  $bridge=Get-Content -LiteralPath $bridgePath -Raw -ErrorAction Stop
+  foreach($symbol in @('r19_collect_vehicle_usb_clock_requests','r19_service_vehicle_usb_clock_reply','r19_intercept_usb_clock_request','vc_lora_r19_diagnostic_usb_failure_record')){
+    if($bridge-notmatch('\b'+[regex]::Escape($symbol)+'\b')){throw ('USB role declaration is not implemented in canonical bridge: '+$symbol)}
+  }
+  $sources=@(foreach($path in $relative){[pscustomobject][ordered]@{path=$path;sha256=(Get-FileHash -LiteralPath (Join-Path $RepoRoot $path) -Algorithm SHA256 -ErrorAction Stop).Hash}})
+  [pscustomobject][ordered]@{
+    schema='vc-lora-r19-usb-role-capabilities-v1';mode=$Mode;implementation_bound=$true
+    canonical_sources=$sources
+    roles=@(
+      [pscustomobject][ordered]@{role='vehicle';clock_request_reply=$true;effective_mode='SyncOnly';ready=$false;arm=$false},
+      [pscustomobject][ordered]@{role='ground';clock_request_reply=$true;effective_mode='ExplicitHostArm';ready=$true;arm=$true})
+  }
+}
+
+function Assert-R19UsbRoleCapabilities {
+  param([object]$Contract,[string]$RepoRoot,[string]$Mode='ExplicitHostArm')
+  Assert-R19UsbRoleCapabilityShape $Contract
+  $expected=Get-R19UsbRoleCapabilities -RepoRoot $RepoRoot -Mode $Mode -Enabled $true
+  if(($Contract|ConvertTo-Json -Depth 15 -Compress)-cne($expected|ConvertTo-Json -Depth 15 -Compress)){throw 'USB role capabilities differ from exact canonical implementation fingerprints'}
+}
+
+function Get-R19UsbRoleEffectiveMode {
+  param([object]$Contract,[ValidateSet('vehicle','ground')][string]$Role,
+    [ValidateSet('SyncOnly','ExplicitHostArm')][string]$RequestedMode,[switch]$AllowLegacyV0)
+  if($null-eq$Contract-and$AllowLegacyV0){
+    # Explicit compatibility with historical role-name-derived workflow v0.
+    # This preserves its behavior; it does NOT declare Vehicle support.
+    if($Role-ceq'vehicle'){return 'SyncOnly'}
+    return $RequestedMode
+  }
+  Assert-R19UsbRoleCapabilityShape $Contract
+  if($RequestedMode-cne$Contract.mode){throw 'Requested mode is not bound to the role capability contract'}
+  return @($Contract.roles|Where-Object{$_.role-ceq$Role})[0].effective_mode
+}
+
+function Assert-R19UsbRolePrivateWrite {
+  param([object]$Contract,[ValidateSet('vehicle','ground')][string]$Role,
+    [ValidateSet('ClockRequest','Arm')][string]$Kind)
+  Assert-R19UsbRoleCapabilityShape $Contract
+  $cap=@($Contract.roles|Where-Object{$_.role-ceq$Role})[0]
+  if(($Kind-ceq'ClockRequest'-and-not$cap.clock_request_reply)-or($Kind-ceq'Arm'-and-not$cap.arm)){throw 'Private USB write is not supported by the exact role contract'}
+}
diff --git a/tests/host/standalone/phase6_vehicle_usb_clock_tests.cpp b/tests/host/standalone/phase6_vehicle_usb_clock_tests.cpp
new file mode 100644
index 0000000..8f9de38
--- /dev/null
+++ b/tests/host/standalone/phase6_vehicle_usb_clock_tests.cpp
@@ -0,0 +1,183 @@
+#include "fake_arduino_test_api.hpp"
+
+namespace {
+std::uint64_t aux_reads{0U};
+int clock_test_digital_read(int pin) noexcept {
+  if (pin == D8) ++aux_reads;
+  return digitalRead(pin);
+}
+}
+#define digitalRead clock_test_digital_read
+#define VC_LORA_PHASE6_VEHICLE 1
+#define VC_LORA_R19_HIGH_SPEED_CANDIDATE 1
+#define VC_LORA_R19_RUNTIME_FAIL_DIAGNOSTICS 1
+#define VC_LORA_R19_TIMED_PATH_DIAGNOSTICS 1
+#define VC_LORA_R19_DIAGNOSTIC_USB_FAILURE_RECORD 1
+#ifndef VC_LORA_R19_USB_READINESS_MODE
+#define VC_LORA_R19_USB_READINESS_MODE 2
+#endif
+#include "phase6/vc_lora_phase6_bridge.hpp"
+#undef digitalRead
+
+#include <algorithm>
+#include <array>
+#include <iostream>
+#include <string>
+
+namespace {
+using namespace vc_lora;
+using namespace vc_lora::experimental;
+using namespace vc_lora_phase6_firmware;
+struct Report {
+  unsigned checks{0U}, failures{0U};
+  void check(bool value, const char* name) {
+    ++checks;
+    if (!value) { ++failures; std::cerr << "FAIL " << name << '\n'; }
+  }
+};
+constexpr std::uint64_t nonce = 5915821819564634567ULL;
+MavlinkFrame request(std::uint64_t value = nonce) {
+  std::array<std::uint8_t,16U> payload{};
+  for (unsigned n=0U;n<8U;++n) payload[8U+n]=static_cast<std::uint8_t>(value>>(8U*n));
+  MavlinkFrame out{};
+  (void)encode_mavlink_v2(0U,249U,193U,111U,payload.data(),payload.size(),out);
+  return out;
+}
+void inject(const MavlinkFrame& frame) {
+  Serial.inject_rx(frame.bytes.data(),frame.size);
+}
+struct Parsed {
+  unsigned clocks{0U}, readies{0U}, diagnostics{0U}, bad_crc{0U};
+  std::uint64_t reply_nonce{0U};
+};
+Parsed parsed_output() {
+  Parsed out{};
+  MavlinkStreamParser parser{};
+  for (const auto byte:Serial.tx_bytes()) {
+    MavlinkFrame frame{};
+    const auto status=parser.push(byte,frame);
+    if (status==MavlinkParseStatus::BadCrc) ++out.bad_crc;
+    if (status!=MavlinkParseStatus::FrameReady) continue;
+    if(frame.system_id==249U&&frame.component_id==194U&&frame.message_id==111U) {
+      ++out.clocks;
+      for(unsigned n=0;n<8U;++n) out.reply_nonce|=static_cast<std::uint64_t>(frame.payload()[8U+n])<<(8U*n);
+    }
+    if(frame.system_id==249U&&(frame.component_id==195U||frame.component_id==196U)) ++out.readies;
+    if(frame.message_id==253U&&frame.size==63U) ++out.diagnostics;
+  }
+  return out;
+}
+void loops(unsigned count,unsigned step_ms=1U) {
+  for(unsigned n=0;n<count;++n) {fake_arduino::advance_time_ms(step_ms);loop_bridge();}
+}
+bool contains(const std::vector<std::uint8_t>& bytes,const MavlinkFrame& frame) {
+  return std::search(bytes.begin(),bytes.end(),frame.bytes.begin(),frame.bytes.begin()+frame.size)!=bytes.end();
+}
+}
+
+int main(int argc,char** argv) {
+  using namespace vc_lora_phase6_firmware;
+  Report report{};
+  const std::string scenario=argc>1?argv[1]:"basic";
+  fake_arduino::reset_platform();
+  fake_arduino::set_pin_input_level(D8,HIGH);
+  Serial.set_plugged(true);Serial.set_endpoint_ready(scenario!="cold_bootstrap");
+  if(scenario=="cold") Serial.set_available_for_write(0);
+  setup_bridge();
+  report.check(bridge_ready&&!runtime_fail_closed,"Vehicle setup succeeds");
+  if(scenario!="cold") loops(2U);
+  const auto req=request();
+  MavlinkFrame validated{};
+  report.check(validate_mavlink_frame(req.bytes.data(),req.size,validated)==MavlinkParseStatus::FrameReady,
+      "live request image remains a canonical 28-byte frame");
+  R19TimedPathSnapshot timed{};
+  report.check(vc_lora_r19_timed_path_record.try_snapshot(timed)&&timed.mode==1U,
+      "Vehicle effective timed-path mode is SyncOnly even with global mode 2");
+  const auto usb_before=Serial.tx_bytes().size();
+  const auto aux_before=aux_reads;
+  if(scenario=="partial"||scenario=="epoch") Serial.set_tx_checked_accept_limit(7U);
+  if(scenario=="zero"||scenario=="deadline") Serial.set_tx_checked_accept_limit(0U);
+  if(scenario=="pending_diag") {
+    fake_arduino::advance_time_ms(R19RuntimeDiagnosticCadence::period_ms);
+    Serial.set_flush_failures(10000U);Serial.set_flush_consumes_timeout(true);
+    for(unsigned n=0;n<10U&&!r19_runtime_fail_diagnostic_transport_failed;++n) loop_bridge();
+    report.check(r19_runtime_fail_diagnostic_flush_pending,"diagnostic flush owns USB first");
+  }
+  if(scenario=="runtime_failed") {runtime_fail_closed=true;bridge_ready=false;}
+  inject(req);
+  if(scenario=="epoch") {
+    loop_bridge();
+    const auto prefix=Serial.tx_bytes().size();
+    report.check(prefix==usb_before+7U,"private accepted prefix exists before epoch loss");
+    Serial.simulate_tx_loss();loops(10U,100U);
+    report.check(Serial.tx_bytes().size()==prefix&&aux_reads>aux_before,
+        "epoch fault retains prefix without replay and still observes AUX");
+  } else if(scenario=="deadline") {
+    loops(52U,10U);
+    const auto stopped=Serial.tx_bytes().size();
+    Serial.set_tx_checked_accept_limit(32U);loops(5U);
+    report.check(stopped==usb_before&&Serial.tx_bytes().size()==stopped,
+        "500ms timeout is permanent and cannot later publish or replay");
+    report.check(aux_reads>=aux_before+52U,"AUX observation survives private timeout");
+  } else if(scenario=="pending_diag") {
+    const auto held=Serial.tx_bytes().size();loops(5U);
+    report.check(Serial.tx_bytes().size()==held&&parsed_output().clocks==0U,
+        "private reply cannot interleave with held diagnostic prefix or flush");
+    Serial.set_flush_failures(0U);Serial.set_flush_consumes_timeout(false);loops(8U);
+  } else if(scenario=="cold_bootstrap") {
+    loops(5U);
+    report.check(Serial.tx_bytes().empty()&&parsed_output().clocks==0U,
+        "private reply waits behind cold bootstrap ownership and unavailable host");
+    Serial.set_endpoint_ready(true);loops(8U);
+  } else if(scenario=="flush_retry") {
+    Serial.set_flush_failures(2U);Serial.set_flush_consumes_timeout(true);
+    const auto flush_begin=Serial.flush_count();
+    loops(2U);
+    report.check(Serial.tx_bytes().size()==usb_before+28U,
+        "retrying clock flush writes payload once, not once per retry");
+    Serial.set_flush_failures(0U);Serial.set_flush_consumes_timeout(false);loops(3U);
+    report.check(Serial.flush_count()>=flush_begin+3U&&
+        Serial.tx_bytes().size()==usb_before+28U,
+        "clock flush-only retry completes without payload replay");
+  } else if(scenario=="cold") {
+    loops(10U);report.check(Serial.tx_bytes().empty(),"cold unavailable writer publishes nothing");
+    Serial.set_available_for_write(256);loops(8U);
+  } else if(scenario=="zero") {
+    loops(10U,10U);report.check(Serial.tx_bytes().size()==usb_before,"zero acceptance publishes no prefix");
+    Serial.set_tx_checked_accept_limit(32U);loops(8U);
+  } else {
+    loops(10U);
+  }
+  report.check(Serial.available()==0,"Vehicle consumes its USB-local request");
+  R19FirstUsbFailureSnapshot first{};
+  report.check(vc_lora_r19_first_usb_failure_record.try_snapshot(first)&&
+      first.sync_count==1U&&first.last_sync_nonce==nonce,"Vehicle records its single validated clock request");
+  const auto out=parsed_output();
+  if(scenario!="epoch"&&scenario!="deadline") {
+    report.check(out.clocks==1U&&out.reply_nonce==nonce&&out.bad_crc==0U,
+        "exactly one complete nonce-matched CRC-valid ClockResponse is published");
+    report.check(vc_lora_r19_timed_path_record.try_snapshot(timed)&&
+        (timed.flags&(2U|4U|8U|16U|32U|64U|128U))==0U,
+        "Vehicle sync never invents Ground-only timed session/ARM/product witnesses");
+  }
+  report.check(out.readies==0U,"Vehicle never emits READY or ARM");
+  report.check(!contains(pixhawk_serial.normal_tx_bytes(),req)&&
+      !contains(e220_serial.normal_tx_bytes(),req),"private clock never leaks to Pixhawk or E220");
+  if(scenario=="basic"||scenario=="partial"||scenario=="zero") {
+    const auto writes=Serial.tx_bytes().size();inject(req);inject(request(nonce+1U));
+    R19HostReadinessCommand arm{};arm.role=R19HostReadinessRole::Ground;
+    arm.reader_session=1U;arm.nonce=nonce;arm.boot_id=1U;arm.usb_epoch=Serial.txLossEpoch();
+    arm.reply_device_us=1U;arm.proof_flags=r19_host_arm_required_proof;
+    MavlinkFrame arm_frame{};(void)r19_encode_host_readiness_frame(0U,arm,arm_frame);inject(arm_frame);
+    auto invalid=req;invalid.bytes[invalid.size-1U]^=1U;inject(invalid);
+    loops(10U);
+    report.check(Serial.available()==0&&Serial.tx_bytes().size()==writes&&parsed_output().clocks==1U,
+        "replay, different nonce, ARM, and invalid CRC are consumed without another reply");
+    report.check(!contains(pixhawk_serial.normal_tx_bytes(),arm_frame)&&
+        !contains(e220_serial.normal_tx_bytes(),arm_frame),"ignored ARM cannot leak to product links");
+  }
+  std::cout<<"IT-R19-VEHICLE-USB-CLOCK scenario="<<scenario<<" checks="<<report.checks
+      <<" failures="<<report.failures<<" clocks="<<out.clocks<<" ready="<<out.readies
+      <<" sync_count="<<first.sync_count<<" aux_reads="<<aux_reads-aux_before<<'\n';
+  return report.failures==0U?0:1;
+}
diff --git a/tests/host/standalone/phase6_diagnostic_usb_failure_tests.cpp b/tests/host/standalone/phase6_diagnostic_usb_failure_tests.cpp
